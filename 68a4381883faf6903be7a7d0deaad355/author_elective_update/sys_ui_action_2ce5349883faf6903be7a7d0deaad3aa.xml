        <action_name>generate_nba</action_name>
        <active>false</active>
        <client>true</client>
        <client_script_v2><![CDATA[function onClick() {

    var incidentSysId = g_form.getUniqueValue();
	
    if (!incidentSysId) {
        return;
    }

    var ga = new GlideAjax('x_ustgl_insighti_0.generateNextBestAction');
    ga.addParam('sysparm_name', 'generateNBAT');
    ga.addParam('sysparm_inc_sys_id', incidentSysId);

    ga.getXMLAnswer(function (response) {

        if (!response) {
            g_form.addErrorMessage('Failed to generate Next Best Action');
            return;
        }

		if (response.startsWith("ERROR:")) {
            g_form.addErrorMessage(response.replace("ERROR:", ""));
            return;
        }

        g_form.setValue('x_ustgl_insighti_0_next_best_actions', response);

        // Save (Workspace + Classic)
        if (typeof g_form.saveRecord === 'function') {
            g_form.saveRecord();
        } else {
            g_form.save();
        }
        g_form.addInfoMessage('Next Best Action generated successfully');
    });
}
]]></client_script_v2>
