        <messages/>
        <name>Hide HTML Field Header and Footer</name>
        <order/>
        <script><![CDATA[function onLoad() {
 var fieldName = 'x_ustgl_insighti_0_next_best_actions';

    var hideHtmlExtras = function() {
        // 1. Target the Zoom Buttons (usually in the main document)
        var zoomButtons = document.querySelectorAll('div[id*="' + fieldName + '"] .sn-html-zoom-container, .icon-zoomin, .icon-zoomout');
        zoomButtons.forEach(function(el) { el.style.display = 'none'; });

        // 2. Target the Status Bar (the 'div' footer) inside the TinyMCE iframe
        var iframe = document.querySelector('iframe[id*="' + fieldName + '"]');
        if (iframe && iframe.contentDocument) {
            var innerDoc = iframe.contentDocument || iframe.contentWindow.document;
            var styleTag = innerDoc.getElementById('hide-footer-style') || innerDoc.createElement('style');
            styleTag.id = 'hide-footer-style';
            styleTag.innerHTML = '.tox-statusbar, .mce-statusbar, .tox-statusbar__path { display: none !important; }';
            innerDoc.head.appendChild(styleTag);
        }
    };

    // Run every 500ms for 5 seconds to catch late-loading editor elements
    var counter = 0;
    var timer = setInterval(function() {
        hideHtmlExtras();
        counter++;
        if (counter > 10) clearInterval(timer); 
    }, 500);
}]]></script>
